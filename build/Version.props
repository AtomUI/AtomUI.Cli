<Project>
  <PropertyGroup>
    <AtomUICliVersionPropsImported>true</AtomUICliVersionPropsImported>
    <AtomUICliVersion Condition="'$(AtomUICliVersion)' == ''">1.0.0-alpha.1</AtomUICliVersion>
    <AtomUICliAssemblyVersion Condition="'$(AtomUICliAssemblyVersion)' == ''">1.0.0.0</AtomUICliAssemblyVersion>
    <AtomUIBaseVersion Condition="'$(AtomUIBaseVersion)' == ''">1.0.0-alpha.1</AtomUIBaseVersion>

    <Version Condition="'$(Version)' == ''">$(AtomUICliVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(AtomUICliAssemblyVersion)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(AtomUICliAssemblyVersion)</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(AtomUICliVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
