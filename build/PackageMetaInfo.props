<Project>
  <PropertyGroup>
    <PackageId Condition="'$(PackageId)' == ''">$(MSBuildProjectName)</PackageId>
    <Title Condition="'$(Title)' == ''">AtomUI.Cli</Title>
    <Author>Qinware Technologies Ltd.</Author>
    <Authors>$(Author)</Authors>
    <Description>AtomUI ecosystem command-line tool for metadata lookup, project diagnostics, setup automation, migration assistance, and MCP integrations.</Description>
    <PackageTags>AtomUI;CLI;dotnet-tool;MCP</PackageTags>
    <ProjectUrl>https://qinware.com</ProjectUrl>
    <RepositoryUrl>https://github.com/AtomUI/AtomUI.Cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Company>Qinware Technologies Ltd.</Company>
    <Copyright>Copyright (c) 2018-2026 Qinware Technologies Co., Ltd. All rights reserved.</Copyright>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Visible="false" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Visible="false" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
